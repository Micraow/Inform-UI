$step=0
root=Stack([Card([
 Row([Text("Find the minimum","default","start","md","semibold"),Text("Step "+($step+1)+" / 5","muted","end","xs")],"sm","center",{wrap:"nowrap",justify:"between"}),
 Grid([Box([Text("6","default","center","lg","semibold"),Text("A[1]","muted","center","xs")],{background:$step==4&&0==3?"success":$step==0?"info":$step>0?"surface":"transparent",padding:"xs",radius:"sm",gap:"xs"}),Box([Text("3","default","center","lg","semibold"),Text("A[2]","muted","center","xs")],{background:$step==4&&1==3?"success":$step==1?"info":$step>1?"surface":"transparent",padding:"xs",radius:"sm",gap:"xs"}),Box([Text("8","default","center","lg","semibold"),Text("A[3]","muted","center","xs")],{background:$step==4&&2==3?"success":$step==2?"info":$step>2?"surface":"transparent",padding:"xs",radius:"sm",gap:"xs"}),Box([Text("2","default","center","lg","semibold"),Text("A[4]","muted","center","xs")],{background:$step==4&&3==3?"success":$step==3?"info":$step>3?"surface":"transparent",padding:"xs",radius:"sm",gap:"xs"}),Box([Text("5","default","center","lg","semibold"),Text("A[5]","muted","center","xs")],{background:$step==4&&4==3?"success":$step==4?"info":$step>4?"surface":"transparent",padding:"xs",radius:"sm",gap:"xs"})],5,"xs","preserve"),
 Row([Text("Smallest so far"),Text($step==0?"6":$step<3?"3":"2","success","end","lg","semibold")],"sm","center",{wrap:"nowrap",justify:"between"}),
 Text($step==0?"Start with the first value.":$step==1?"3 is smaller than 6. Keep 3.":$step==2?"8 is not smaller than 3. Keep 3.":$step==3?"2 is smaller than 3. Keep 2.":"5 is not smaller than 2. The final minimum is 2.","default","start","sm"),
 Row([Button("Previous",@Set($step,$step-1),"secondary",$step==0),Button("Next",@Set($step,$step+1),"primary",$step==4)],"sm","center",{wrap:"nowrap",justify:"between"})
])])
