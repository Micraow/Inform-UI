        {
          "type": "row",
          "children": [
            {
              "type": "button",
              "label": "设为增益 3",
              "action": {
                "kind": "set",
                "bind": "gain",
                "value": 3
              }
            },
            {
              "type": "button",
              "label": "重置所有参数",
              "action": {
                "kind": "reset"
              }
            }
          ]
        }
      ]
