{
  "version": "iui/1",
  "title": "把内容排清楚",
  "description": "原创合成示例：同一份 JSON 生成富文本、引用和响应式网格。",
  "state": { "hits": 75 },
  "body": [
    { "type": "title", "value": "从一句话到结构化页面" },
    { "type": "text", "runs": [
      { "value": "实验记录 ", "bold": true },
      { "value": "cache_hit", "code": true },
      { "value": " 的合成计数为 " },
      { "value": { "$": "hits" }, "bold": true },
      { "value": "。趋势只是示意，", "italic": true },
      { "value": "请保留原始观测。", "underline": true }
    ] },
    { "type": "slider", "label": "合成命中数", "bind": "hits", "min": 0, "max": 100, "step": 1 },
    { "type": "text", "value": "已撤回的猜想：所有缓存访问都能命中。", "strike": true, "color": "secondary" },
    { "type": "blockquote", "children": [
      { "type": "text", "runs": [{ "value": "把结论和条件放在一起。", "italic": true }, { "value": "一个数字只有在单位、来源和边界清楚时才有用。" }] }
    ], "attribution": "本项目原创写作示例" },
    { "type": "title", "level": 2, "value": "保持顺序的网格" },
    { "type": "grid", "columns": 3, "mobileColumns": 2, "gap": 3, "children": [
      { "type": "grid-item", "colSpan": 2, "rowSpan": 2, "mobileColSpan": 2, "children": [
        { "type": "card", "children": [{ "type": "caption", "value": "01 · 主要结论" }, { "type": "text", "value": "宽块承载解释；小屏上保持 DOM 阅读顺序，行跨度恢复自动。" }] }
      ] },
      { "type": "metric", "variant": "plain", "label": "命中", "value": { "$": "hits" }, "unit": "次" },
      { "type": "metric", "variant": "plain", "label": "未命中", "value": { "op": "sub", "args": [100, { "$": "hits" }] }, "unit": "次" },
      { "type": "grid-item", "colSpan": 3, "mobileColSpan": 2, "children": [{ "type": "caption", "value": "所有数字均为本地合成；调整上方输入即可重算。" }] }
    ] },
    { "type": "code", "inline": true, "value": "average = hit × fast + miss × slow" },
    { "type": "text", "value": "此行展示可选装饰性微光，减少动态效果时自动停止。", "shimmer": true },
    { "type": "text", "runs": [{ "value": "链接也属于受限文本：" }, { "value": "HTML 表格规范", "href": "https://html.spec.whatwg.org/multipage/tables.html" }] }
  ]
}
