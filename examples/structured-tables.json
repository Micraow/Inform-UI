      "sections": [
        { "kind": "head", "rows": [
          [ { "value": "Group", "rowSpan": 2, "colSpan": 2 }, { "value": "Measurements", "colSpan": 2, "align": "center" }, { "value": "Notes", "rowSpan": 2 } ],
