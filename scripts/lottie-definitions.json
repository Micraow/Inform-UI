  "LottieJSON": {
    "anyOf": [
      {
        "type": "null"
      },
      {
        "type": "boolean"
      },
      {
        "type": "number"
      },
      {
        "type": "string",
        "maxLength": 200000
      },
      {
        "type": "array",
        "items": {
          "$ref": "#/$defs/LottieJSON"
        },
        "minItems": 0,
        "maxItems": 500
      },
      {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/LottieJSON"
        }
      }
    ]
