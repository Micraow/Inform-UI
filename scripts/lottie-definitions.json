  "LottieData": {
    "type": "object",
    "properties": {
      "v": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "w": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "h": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "fr": {
        "type": "number",
        "minimum": 1,
        "maximum": 240
      },
      "ip": {
        "type": "number",
        "minimum": 0,
        "maximum": 864000
      },
      "op": {
        "type": "number",
        "minimum": 0,
        "maximum": 864000
      },
      "layers": {
        "type": "array",
