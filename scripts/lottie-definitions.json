        "maximum": 4096
      },
      "height": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "aspectRatio": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 100
      },
      "fit": {
        "enum": [
          "contain",
          "cover",
          "fill",
          "none"
        ]
      },
      "loop": {
        "type": "boolean"
      },
      "currentTime": {
        "$ref": "#/$defs/Value"
