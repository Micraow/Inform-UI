{
  "AsyncImageGroupNode": {
    "type": "object",
    "properties": {
      "type": {
        "const": "async-image-group"
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "images": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SearchImageRecord"
        },
        "minItems": 0,
        "maxItems": 20
      },
      "status": {
        "$ref": "#/$defs/Value"
      },
      "interactive": {
        "type": "boolean"
      },
      "disabled": {
        "type": "boolean"
      },
      "fallback": {
        "type": "string",
        "maxLength": 2000
      },
      "layout": {
        "enum": [
          "carousel",
          "bento"
        ]
      },
      "size": {
        "enum": [
          "sm",
          "lg"
        ]
      },
      "aspectRatio": {
        "anyOf": [
          {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]+(?:\\.[0-9]+)?\\s*[:/]\\s*[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])"
          }
        ]
      },
      "itemWidth": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          {
            "type": "string",
            "pattern": "^(?:100|[1-9]?[0-9](?:\\.[0-9]{1,3})?)%$(?![\\s\\S])"
          }
        ]
      },
      "itemHeight": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      }
    },
    "required": [
      "type",
      "images"
    ],
    "additionalProperties": false
  },
  "AsyncImageNode": {
    "type": "object",
    "properties": {
      "type": {
        "const": "async-image"
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "images": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SearchImageRecord"
        },
        "minItems": 0,
        "maxItems": 20
      },
      "status": {
        "$ref": "#/$defs/Value"
      },
      "interactive": {
        "type": "boolean"
      },
      "disabled": {
        "type": "boolean"
      },
      "fallback": {
        "type": "string",
        "maxLength": 2000
      },
      "alt": {
        "type": "string",
        "maxLength": 2000
      },
      "width": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          {
            "type": "string",
            "pattern": "^(?:100|[1-9]?[0-9](?:\\.[0-9]{1,3})?)%$(?![\\s\\S])"
          }
        ]
      },
      "height": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          {
            "type": "string",
            "pattern": "^(?:100|[1-9]?[0-9](?:\\.[0-9]{1,3})?)%$(?![\\s\\S])"
          }
        ]
      },
      "minWidth": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4096
      },
      "minHeight": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4096
      },
      "maxWidth": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          {
            "type": "string",
            "pattern": "^(?:100|[1-9]?[0-9](?:\\.[0-9]{1,3})?)%$(?![\\s\\S])"
          }
        ]
      },
      "maxHeight": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "aspectRatio": {
        "anyOf": [
          {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]+(?:\\.[0-9]+)?\\s*[:/]\\s*[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])"
          }
        ]
      },
      "fit": {
        "enum": [
          "cover",
          "contain",
          "fill",
          "none",
          "scale-down"
        ]
      },
      "frame": {
        "type": "boolean"
      },
      "radius": {
        "type": "integer",
        "minimum": 0,
        "maximum": 256
      }
    },
    "required": [
      "type",
      "images"
    ],
    "additionalProperties": false
  },
  "SearchImagePlacement": {
    "type": "object",
    "properties": {
      "left": {
        "type": "number",
        "minimum": -1000,
        "maximum": 1000
      },
      "top": {
        "type": "number",
        "minimum": -1000,
        "maximum": 1000
      },
      "width": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000
      },
      "height": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000
      }
    },
    "required": [
      "left",
      "top",
      "width",
      "height"
    ],
    "additionalProperties": false
  },
  "SearchImagePresentation": {
    "type": "object",
    "properties": {
      "aspect_ratio": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000
      },
      "placement": {
        "$ref": "#/$defs/SearchImagePlacement"
      }
    },
    "required": [
      "aspect_ratio",
      "placement"
    ],
    "additionalProperties": false
  },
  "SearchImageRecord": {
    "type": "object",
    "properties": {
      "content_url": {
        "type": "string",
        "maxLength": 500000
      },
      "thumbnail_url": {
        "type": "string",
        "maxLength": 500000
      },
      "title": {
        "type": "string",
        "maxLength": 2000
      },
      "content_size": {
        "$ref": "#/$defs/SearchImageSize"
      },
      "thumbnail_size": {
        "$ref": "#/$defs/SearchImageSize"
      },
      "thumbnail_crop_info": {
        "type": "object",
        "properties": {
          "center_x_percent": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          },
          "center_y_percent": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          }
        },
        "required": [
          "center_x_percent",
          "center_y_percent"
        ],
        "additionalProperties": false
      },
      "content_presentation": {
        "$ref": "#/$defs/SearchImagePresentation"
      },
      "thumbnail_presentation": {
        "$ref": "#/$defs/SearchImagePresentation"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "SearchImageSize": {
    "type": "object",
    "properties": {
      "width": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      },
      "height": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      }
    },
    "required": [
      "width",
      "height"
    ],
    "additionalProperties": false
  },
  "Value": {
    "oneOf": [
      {
        "type": "string",
        "maxLength": 12000
      },
      {
        "type": "number"
      },
      {
        "type": "boolean"
      },
      {
        "type": "null"
      },
      {
        "type": "object",
        "properties": {
          "$": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$",
            "minLength": 1
          }
        },
        "required": [
          "$"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "enum": [
              "add",
              "sub",
              "mul",
              "div",
              "max",
              "min",
              "round",
              "abs",
              "clamp",
              "gt",
              "lt",
              "eq",
              "if",
              "format"
            ]
          },
          "args": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Value"
            },
            "minItems": 1,
            "maxItems": 12
          }
        },
        "required": [
          "op",
          "args"
        ],
        "additionalProperties": false
      }
    ]
  }
}
