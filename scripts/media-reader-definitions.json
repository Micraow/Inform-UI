{
  "YoutubeNode": {
    "type": "object",
    "properties": {
      "type": {
        "const": "youtube"
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "loadMode": {
        "enum": [
          "direct",
          "on-demand"
        ]
      },
      "videoId": {
        "type": "string",
        "minLength": 11,
        "maxLength": 11,
        "pattern": "^[A-Za-z0-9_-]{11}$(?![\\s\\S])"
      },
      "caption": {
        "type": "string",
        "maxLength": 2000
      },
      "startSeconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 86400
      },
      "fullscreen": {
        "type": "boolean"
      },
      "disabled": {
        "$ref": "#/$defs/Value"
      }
    },
    "required": [
      "type",
      "label",
      "videoId"
    ],
    "additionalProperties": false
  },
  "SearchImageNode": {
    "type": "object",
    "properties": {
      "type": {
        "const": "search-image"
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "searchImage": {
        "anyOf": [
          {
            "$ref": "#/$defs/SearchImageRecord"
          },
          {
            "type": "null"
          }
        ]
      },
      "alt": {
        "type": "string",
        "maxLength": 2000
      },
      "width": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          {
            "type": "string",
            "pattern": "^(?:100|[1-9]?[0-9](?:\\.[0-9]{1,3})?)%$(?![\\s\\S])"
          }
        ]
      },
      "height": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          {
            "type": "string",
            "pattern": "^(?:100|[1-9]?[0-9](?:\\.[0-9]{1,3})?)%$(?![\\s\\S])"
          }
        ]
      },
      "minWidth": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          {
            "type": "string",
            "pattern": "^(?:100|[1-9]?[0-9](?:\\.[0-9]{1,3})?)%$(?![\\s\\S])"
          }
        ]
      },
      "minHeight": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          {
            "type": "string",
            "pattern": "^(?:100|[1-9]?[0-9](?:\\.[0-9]{1,3})?)%$(?![\\s\\S])"
          }
        ]
      },
      "maxWidth": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          {
            "type": "string",
            "pattern": "^(?:100|[1-9]?[0-9](?:\\.[0-9]{1,3})?)%$(?![\\s\\S])"
          }
        ]
      },
      "maxHeight": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          {
            "type": "string",
            "pattern": "^(?:100|[1-9]?[0-9](?:\\.[0-9]{1,3})?)%$(?![\\s\\S])"
          }
        ]
      },
      "aspectRatio": {
        "anyOf": [
          {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]+(?:\\.[0-9]+)?\\s*[:/]\\s*[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])"
          }
        ]
      },
      "fit": {
        "enum": [
          "cover",
          "contain",
          "fill",
          "none",
          "scale-down"
        ]
      },
      "position": {
        "type": "string",
        "maxLength": 50,
        "pattern": "^[0-9]+(?:\\.[0-9]+)?% [0-9]+(?:\\.[0-9]+)?%$(?![\\s\\S])"
      },
      "frame": {
        "type": "boolean"
      },
      "radius": {
        "type": "integer",
        "minimum": 0,
        "maximum": 256
      },
      "hoverZoom": {
        "type": "boolean"
      },
      "hideOnFailure": {
        "type": "boolean"
      },
      "sourcePending": {
        "type": "boolean"
      },
      "upgradeToFullRes": {
        "const": false
      },
      "fallback": {
        "type": "string",
        "maxLength": 2000
      },
      "contentCropFit": {
        "enum": [
          "contain",
          "cover"
        ]
      },
      "containOutsideAspectRatio": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "max": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "min",
          "max"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "type",
      "searchImage"
    ],
    "additionalProperties": false
  },
  "SearchImageRecord": {
    "type": "object",
    "properties": {
      "content_url": {
        "type": "string",
        "maxLength": 500000
      },
      "thumbnail_url": {
        "type": "string",
        "maxLength": 500000
      },
      "title": {
        "type": "string",
        "maxLength": 2000
      },
      "content_size": {
        "$ref": "#/$defs/SearchImageSize"
      },
      "thumbnail_size": {
        "$ref": "#/$defs/SearchImageSize"
      },
      "thumbnail_crop_info": {
        "type": "object",
        "properties": {
          "center_x_percent": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          },
          "center_y_percent": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          }
        },
        "required": [
          "center_x_percent",
          "center_y_percent"
        ],
        "additionalProperties": false
      },
      "content_presentation": {
        "$ref": "#/$defs/SearchImagePresentation"
      },
      "thumbnail_presentation": {
        "$ref": "#/$defs/SearchImagePresentation"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "SearchImagePresentation": {
    "type": "object",
    "properties": {
      "aspect_ratio": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000
      },
      "placement": {
        "$ref": "#/$defs/SearchImagePlacement"
      }
    },
    "required": [
      "aspect_ratio",
      "placement"
    ],
    "additionalProperties": false
  },
  "SearchImagePlacement": {
    "type": "object",
    "properties": {
      "left": {
        "type": "number",
        "minimum": -1000,
        "maximum": 1000
      },
      "top": {
        "type": "number",
        "minimum": -1000,
        "maximum": 1000
      },
      "width": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000
      },
      "height": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000
      }
    },
    "required": [
      "left",
      "top",
      "width",
      "height"
    ],
    "additionalProperties": false
  },
  "SearchImageSize": {
    "type": "object",
    "properties": {
      "width": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      },
      "height": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      }
    },
    "required": [
      "width",
      "height"
    ],
    "additionalProperties": false
  }
}
