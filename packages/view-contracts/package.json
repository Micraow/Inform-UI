{
  "name": "@micraow/inform-view-contracts",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "generate": "npm run build && node scripts/generate.mjs",
    "test": "npm run build && node --test --test-isolation=none tests/*.test.mjs",
    "check": "npm run typecheck && npm test && node --disallow-code-generation-from-strings --test --test-isolation=none tests/*.test.mjs && npm run generate"
  },
  "devDependencies": { "esbuild": "0.25.10", "typescript": "5.9.3", "zod": "4.1.12" }
}
