{
  "name": "@micraow/intelligent-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Independent, deterministic scientific UI from iui/1 JSON",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./schema": "./src/schema/iui.schema.json",
    "./style.css": "./dist/style.css"
  },
  "bin": {
    "iui": "./bin/iui.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src/schema/iui.schema.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "generate": "node scripts/generate-schema.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check": "npm run generate && npm run build && npm run typecheck && npm test && npm run test:types && npm run check:boundary",
    "test:types": "tsc --noEmit --strict --module NodeNext --target ES2022 --skipLibCheck tests/types-consumer.mts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "katex": "0.16.22"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/katex": "0.16.7",
    "@types/node": "22.18.6",
    "esbuild": "0.25.10",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3"
  }
}
