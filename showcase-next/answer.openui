hero="data:image/png;base64,"
$budget=160
$order="asc"
$chosen="Nothing selected yet"
trips=[{name:"Riverside weekend",cost:95,description:"A quiet town, a riverside walk, and a small local museum."},{name:"Coastal escape",cost:145,description:"A beach walk, fresh air, and a late lunch by the harbour."},{name:"Mountain retreat",cost:210,description:"A scenic trail and a relaxed evening in the hills."}]
visible=@Sort(@Filter(trips,"cost","<=",$budget),"cost",$order)
root=Stack([
 Badge("AN INTERACTIVE ANSWER"),
 Heading("A weekend that fits your plans",1),
 Text("Here are three illustrative options. Adjust the budget, compare the shortlist, and choose a favourite. Everything below runs locally; these are sample prices, not live offers.","muted"),
 Image(hero,"An original abstract color study","Original illustration for this fictional itinerary"),
 Grid([
  Card([Slider("Maximum sample budget",$budget,80,240,5),Select("Sort options",$order,[{label:"Lowest cost first",value:"asc"},{label:"Highest cost first",value:"desc"}])],"Make it yours"),
  Card([Heading("Your shortlist",2),Text(@Count(visible)+" options within budget"),Text("Selected: "+$chosen),Button("Reset selection",@Reset($chosen),"secondary")],"At a glance")
 ],2,"lg"),
 @Count(visible)==0 ? Alert("No options in this range","Increase the budget to see a few ideas.","warning") : Stack(@Each(visible,"trip",Card([
  Row([Icon("MapPin"),Heading(trip.name,3)],"sm"),
  Text(trip.description),
  Row([Badge("Sample cost: "+trip.cost),Button("Choose this option",@Set($chosen,trip.name),"secondary")],"lg")
 ])),"lg"),
 BarChart("Compare the current shortlist",visible.name,[Series("Sample cost",visible.cost)]),
 Divider(),
 Alert("A suggestion, not a booking","Choosing an option only updates this local answer. No reservation, payment, or external request occurs.","default")
],"xl")
