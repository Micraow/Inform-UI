{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Node",
  "$id": "urn:micraow:inform-ui:schema:iui:1:2a1f61103276751a736453ec66d47a53ce4eaafba156ee8c2e259b19d8e14c04:node:learning",
  "title": "Inform UI node subset: learning",
  "description": "Node structural subset for field lookup, not a Document schema. Use the corresponding Document bundle or a union for authored pages.",
  "$defs": {
    "Flashcard": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$"
        },
        "front": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "back": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "frontLatex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "backLatex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "hint": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "front",
        "back"
      ],
      "additionalProperties": false
    },
    "FlashcardsNode": {
      "type": "object",
      "properties": {
        "type": {
          "const": "flashcards"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 12000
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Flashcard"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "status": {
          "enum": [
            "ready",
            "loading",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 12000
        }
      },
      "required": [
        "type",
        "title",
        "cards"
      ],
      "additionalProperties": false
    },
    "Node": {
      "oneOf": [
        {
          "$ref": "#/$defs/QuizNode"
        },
        {
          "$ref": "#/$defs/FlashcardsNode"
        }
      ]
    },
    "QuizNode": {
      "type": "object",
      "properties": {
        "type": {
          "const": "quiz"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 12000
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuizQuestion"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "status": {
          "enum": [
            "ready",
            "loading",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 12000
        }
      },
      "required": [
        "type",
        "title",
        "questions"
      ],
      "additionalProperties": false
    },
    "QuizQuestion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$"
        },
        "kind": {
          "enum": [
            "single",
            "multiple"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "latex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 20
        },
        "correct": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "explanation": {
          "type": "string",
          "maxLength": 6000
        },
        "explanationLatex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "id",
        "kind",
        "prompt",
        "choices",
        "correct",
        "explanation"
      ],
      "additionalProperties": false
    }
  }
}
