    "FillBlankEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 8
        },
        "hint": {
          "type": "string",
          "maxLength": 1000
        },
        "explanation": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "label",
        "answers"
      ],
      "additionalProperties": false
    },
    "FillBlankNode": {
      "type": "object",
      "properties": {
        "type": {
          "const": "fill-blank"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FillBlankPart"
          },
          "minItems": 1,
          "maxItems": 50
