        "blanks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FillBlankEntry"
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "type",
        "title",
        "parts",
        "blanks"
      ],
      "additionalProperties": false
    },
    "FillBlankPart": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "object",
          "properties": {
            "blank": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$"
            }
